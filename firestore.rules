rules_version = '2';

// Flashcards security rules.
//
// The browser talks to Firestore directly, so these rules are the only thing keeping one person's
// collection away from another. Ownership is the {userId} path segment, never a document field.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // updatedAt is always the server's clock (serverTimestamp()), never one a client makes up
    function stamped(d) {
      return !('updatedAt' in d) || d.updatedAt == request.time;
    }

    // A named group of cards, studied when active (the default). The cards live in the
    // collection document itself, as a list of { id, word, translation }, so loading every word
    // costs one read per collection rather than one per card, and an import is a single write.
    // Rules can't look inside list items: cloud.js trims each card to its fields and length
    // limits (cardFields), and only the owner can write here anyway. Typical words keep 5,000
    // cards well under Firestore's 1 MiB document limit; long ones could pass it, so cloud.js
    // checks the size before writing (MAX_CARDS_BYTES in card-data.js).
    function isCollection(d) {
      return d.keys().hasOnly(['name', 'active', 'cards', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && (!('active' in d) || d.active is bool)
        && (!('cards' in d) || (d.cards is list && d.cards.size() <= 5000))
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && stamped(d);
    }

    // Learning progress, spaced repetition: srs maps each card id to { box, due }. The app
    // saves only the entries that changed, merged into this.
    function isProgress(d) {
      return d.keys().hasOnly(['srs', 'updatedAt'])
        && (!('srs' in d) || (d.srs is map && d.srs.size() <= 20000))
        && stamped(d);
    }

    match /users/{userId}/collections/{collectionId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isCollection(request.resource.data);
    }

    match /users/{userId}/meta/progress {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isProgress(request.resource.data);
    }

    // Everything else is denied, including the user document itself.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
